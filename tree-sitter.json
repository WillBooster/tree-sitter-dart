{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "dart",
      "camelcase": "Dart",
      "title": "Dart",
      "scope": "source.dart",
      "path": ".",
      "file-types": ["dart"],
      "injection-regex": "^dart$",
      "class-name": "TreeSitterDart"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "Dart grammar for tree-sitter",
    "authors": [
      {
        "name": "WillBooster Inc."
      }
    ],
    "links": {
      "repository": "https://github.com/WillBooster/tree-sitter-dart"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
